let health = 100;
let damage = 18;
let armor = 6;
let taken = damage - armor;
let healthAfterHit = health - taken;
print(healthAfterHit);
print("\n");

let mana = 80;
let spellCost = 12;
let spellCount = 3;
let manaUsed = spellCost * spellCount;
let manaLeft = mana - manaUsed;
print(manaLeft);
print("\n");

let coins = 25;
let gems = 4;
let gemValue = 15;
let treasure = coins + gems * gemValue;
print(treasure);
print("\n");

let baseScore = 1000;
let waveBonus = 250;
let killBonus = 35;
let kills = 12;
let finalScore = baseScore + waveBonus + killBonus * kills;
print(finalScore);
print("\n");

let width = 64;
let height = 32;
let area = width * height;
let halfArea = area / 2;
print(area);
print("\n");
print(halfArea);
print("\n");

let speed = 12f;
let time = 8f;
let distance = speed * time;
print(distance);
print("\n");

let fuel = 100f;
let burnRate = 6.5f;
let travelTime = 9f;
let fuelUsed = burnRate * travelTime;
let fuelLeft = fuel - fuelUsed;
print(fuelLeft);
print("\n");

let price = 75f;
let taxPart = price / 10f;
let totalPrice = price + taxPart;
print(totalPrice);
print("\n");

let enemyHealth = 140;
let sword = 22;
let arrow = 14;
let fire = 35;
let totalDamage = sword + arrow + fire;
let enemyLeft = enemyHealth - totalDamage;
print(enemyLeft);
print("\n");

let iron = 50;
let wood = 75;
let stone = 120;
let food = 90;
let totalSupplies = iron + wood + stone + food;
print(totalSupplies);
print("\n");

let workers = 8;
let hours = 6;
let workRate = 12;
let production = workers * hours * workRate;
print(production);
print("\n");

let basePower = 40;
let upgradeOne = 10;
let upgradeTwo = 15;
let multiplier = 3;
let power = basePower + upgradeOne + upgradeTwo * multiplier;
print(power);
print("\n");

let x = 5;
let y = 9;
let z = 13;
let mixed = x + y * z - 20;
print(mixed);
print("\n");

let a = 200;
let b = 25;
let c = 4;
let divided = a / b + c;
print(divided);
print("\n");

let level = 7;
let levelReward = 100;
let reward = level * levelReward;
print(reward);
print("\n");

let stamina = 55f;
let sprintCost = 4.5f;
let sprintSeconds = 6f;
let staminaLost = sprintCost * sprintSeconds;
let staminaLeft = stamina - staminaLost;
print(staminaLeft);
print("\n");

let message = "large ankle arithmetic test";
print(message);
print("\n");

let status = "done";
print(status);
